[Unit]
Description=Messages for Scout (inlovingmemoryofscout.com guestbook)
After=network.target

[Service]
ExecStart=/usr/bin/node /var/www/inlovingmemoryofscout.com/html/server/messages.js
EnvironmentFile=/etc/scout-messages.env
# Runs as a throwaway unprivileged user; messages live in /var/lib/scout-messages.
DynamicUser=yes
StateDirectory=scout-messages
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
